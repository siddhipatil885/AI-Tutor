# Neon pooled connection string (use your actual username, password, host, and database).
# Keep sslmode=require; Neon requires TLS.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Use Neon’s direct (non-pooler) URL only when running future schema migrations.
DATABASE_URL_UNPOOLED=postgresql+psycopg://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSIONS=384
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_DEFAULT_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.55
VITE_NEON_AUTH_URL=https://your-neon-auth-host/neondb/auth
