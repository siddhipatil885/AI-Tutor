# Neon pooled connection string (replace all placeholders locally).
# Keep sslmode=require; Neon requires TLS.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR_NEON_HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Use the direct (non-pooler) URL only for migrations.
DATABASE_URL_UNPOOLED=postgresql+psycopg://USER:PASSWORD@YOUR_NEON_HOST.REGION.aws.neon.tech/neondb?sslmode=require
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSIONS=384
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_DEFAULT_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.55
NEON_BRANCH=YOUR_NEON_BRANCH
NEON_AUTH_BASE_URL=https://YOUR_NEON_AUTH_HOST/neondb/auth
VITE_NEON_AUTH_URL=https://YOUR_NEON_AUTH_HOST/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR_NEON_AUTH_HOST/neondb/auth/.well-known/jwks.json
NEON_AUTH_ISSUER=https://YOUR_NEON_AUTH_HOST/neondb/auth
NEON_AUTH_AUDIENCE=authenticated
NEON_AUTH_TEACHER_EMAILS=
NEON_AUTH_ADMIN_EMAILS=
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_ENDPOINT_URL_S3=https://YOUR_STORAGE_ENDPOINT
AWS_REGION=YOUR_AWS_REGION
